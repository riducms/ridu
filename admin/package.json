{
	"name": "@riducms/admin",
	"description": "Framework-owned Svelte 5 authoring application embedded by Ridu servers.",
	"version": "0.16.1",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riducms/ridu.git",
		"directory": "admin"
	},
	"homepage": "https://riducms.com",
	"bugs": {
		"url": "https://github.com/riducms/ridu/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./routing": "./src/routing.ts"
	},
	"files": [
		"src",
		"!src/tsconfig.json"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "tsc -p tsconfig.node.json && bun ../scripts/check-admin-ui-policy.ts",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && svelte-check --tsconfig ./tsconfig.test.json",
		"test": "bun run test:unit && bun run test:components",
		"test:unit": "bun test tests",
		"test:components": "vitest run --config vitest.config.ts"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.5",
		"@codemirror/view": "^6.43.12",
		"@cropper/element-canvas": "2.2.0",
		"@cropper/element-handle": "2.2.0",
		"@cropper/element-selection": "2.2.0",
		"@dnd-kit-svelte/svelte": "^0.1.6",
		"@fontsource-variable/martian-mono": "5.3.0",
		"@hvniel/svelte-router": "^0.1.0",
		"@iconify/json": "^2.2.509",
		"@internationalized/date": "^3.12.3",
		"@lezer/highlight": "^1.2.3",
		"@riducms/plugin": "workspace:*",
		"@riducms/protocol": "workspace:*",
		"@riducms/sdk": "workspace:*",
		"@riducms/translations": "workspace:*",
		"@riducms/ui": "workspace:*",
		"@twinkleplop/bash": "0.1.5",
		"@twinkleplop/go": "0.1.5",
		"@twinkleplop/typescript": "0.1.5",
		"bits-ui": "^2.18.1",
		"svelte-sonner": "^1.1.1"
	},
	"devDependencies": {
		"@hvniel/lexical-svelte": "^0.1.1",
		"@riducms/build": "workspace:*",
		"svelte": "^5.57.0"
	},
	"peerDependencies": {
		"svelte": "^5.57.0"
	}
}

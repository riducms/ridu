  "components": {
    "schemas": {
      "AccessCapabilities": {
        "type": "object",
        "properties": {
          "fields": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldCapabilities"
            },
            "type": "object"
          },
          "operations": {
            "$ref": "#/components/schemas/OperationCapabilities"
          }
        },
        "required": [
          "operations",
          "fields"
        ]
      },
      "AuthBootstrapEnvelope": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "available"
        ]
      },
      "CollectionSelectionEnvelope": {
        "type": "object",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CollectionSelectionItem"
            },
            "type": "array"
          },
          "totalDocs": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "totalDocs"
        ]
      },
      "CollectionSelectionInput": {
        "type": "object",
        "properties": {
          "trash": {
            "type": "boolean"
          },
          "where": {
            "type": "object"
          }
        }
      },
      "CollectionSelectionItem": {
        "type": "object",
        "properties": {
          "access": {
            "$ref": "#/components/schemas/AccessCapabilities"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "access"
        ]
      },
      "FieldCapabilities": {
        "type": "object",
        "properties": {
          "create": {
            "type": "boolean"
          },
          "read": {
            "type": "boolean"
          },
          "update": {
            "type": "boolean"
          }
        },
        "required": [
          "read",
          "create",
          "update"
        ]
      },
      "OperationCapabilities": {
        "type": "object",
        "properties": {
          "admin": {
            "type": "boolean"
          },
          "create": {
            "type": "boolean"
          },
          "delete": {
            "type": "boolean"
          },
          "deletePermanent": {
            "type": "boolean"
          },
          "duplicate": {
            "type": "boolean"
          },
          "publish": {
            "type": "boolean"
          },
          "read": {
            "type": "boolean"
          },
          "readVersions": {
            "type": "boolean"
          },
          "restoreDeleted": {
            "type": "boolean"
          },
          "selectAll": {
            "type": "boolean"
          },
          "unpublish": {
            "type": "boolean"
          },
          "update": {
            "type": "boolean"
          }
        },
        "required": [
          "admin",
          "create",
          "read",
          "readVersions",
          "update",
          "delete",
          "duplicate",
          "publish",
          "unpublish",
          "restoreDeleted",
          "deletePermanent",
          "selectAll"
        ]
      },
      "posts": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string",
            "nullable": true
          },
          "content": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "root": {
                    "type": "object"
                  },
                  "version": {
                    "const": 1
                  }
                },
                "required": [
                  "version",
                  "root"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "nullable": true,
            "enum": [
              "draft",
              "published"
            ]
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "createdAt",
          "updatedAt",
          "title"
        ]
      },
      "users": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "createdAt",
          "updatedAt",
          "email"
        ]
      }
    }
  }
}

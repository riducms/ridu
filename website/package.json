{
	"name": "ridu-website",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"packageManager": "bun@1.4.0",
	"overrides": {
		"nanoid": "3.3.18"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"check": "astro check",
		"check:build": "bun scripts/check-build.ts",
		"check:examples": "bun x tsc -p ../examples/documentation/tsconfig.json",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"preview": "astro preview",
		"reference:generate": "bun scripts/generate-reference.ts",
		"reference:check": "bun scripts/generate-reference.ts --check",
		"test": "bun test",
		"verify": "bun run reference:check && bun run lint && bun run check && bun run check:examples && bun run test && bun run build && bun run check:build"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/martian-mono": "^5.2.8",
		"@fontsource/questrial": "^5.2.8",
		"astro": "^7.0.6"
	},
	"devDependencies": {
		"@riducms/build": "file:../packages/build",
		"@astrojs/check": "^0.9.6",
		"@astrojs/markdown-satteri": "0.3.7",
		"@iconify/json": "^2.2.518",
		"@iconify/utils": "^3.1.4",
		"@types/bun": "^1.4.0",
		"@types/mdast": "^4.0.4",
		"@unocss/astro": "^66.7.5",
		"github-slugger": "^2.0.0",
		"mdast-util-from-markdown": "^2.0.3",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"svelte2tsx": "^0.7.47",
		"typescript": "6.0.3",
		"unocss": "^66.7.5",
		"unplugin-icons": "^23.0.1"
	}
}

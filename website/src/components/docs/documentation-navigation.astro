---
import DocumentationNavigationItem from '@/components/docs/documentation-navigation-item.astro';
import type { DocumentationNavigationSection } from '@/config/documentation';

interface Props {
	sections: DocumentationNavigationSection[];
	path: string;
}

const { sections, path } = Astro.props;
---

{
	sections.map((section) => (
		<section class="mt-6 first:mt-0">
			<h2 class="mt-0 mb-1.5 font-body text-13.5px font-650 text-ink">{section.label}</h2>
			<ul class="m-0 list-none p-0">
				{section.items.map((item) => (
					<DocumentationNavigationItem {item} {path} />
				))}
			</ul>
		</section>
	))
}

---
import { Code } from 'astro:components';
import { riduCodeTheme } from '@/config/code-theme';

// A working Dockerfile: `ridu build` output is a static executable (SQLite is
// pure Go), so a distroless base with CA certificates is all it needs.
const databases = [
	{
		id: 'postgres',
		label: 'PostgreSQL',
		env: 'ENV DATABASE_URL=postgres://…',
		note: 'Your PostgreSQL connection URL'
	},
	{
		id: 'sqlite',
		label: 'SQLite',
		env: 'ENV RIDU_SQLITE_PATH=/data/app.sqlite',
		note: 'One file on a mounted volume'
	},
	{
		id: 'mongodb',
		label: 'MongoDB',
		env: 'ENV DATABASE_URL=mongodb+srv://…',
		note: 'A replica set over verified TLS'
	}
] as const;

const lines = [
	{
		code: 'FROM gcr.io/distroless/static-debian12',
		note: 'No Node, no npm, not even a shell'
	},
	{ code: 'COPY dist/my-app /app', note: 'The API, admin, and background jobs' },
	{ database: true },
	{ code: 'EXPOSE 8080', note: 'Health checks answer at /readyz' },
	{ code: 'ENTRYPOINT ["/app"]', note: 'Refuses to start on an unmigrated database' }
] as const;

const dockerfile = (env: string) =>
	lines.map((line) => ('database' in line ? env : line.code)).join('\n');
---

<section
	class="grid grid-cols-[minmax(0,1fr)] items-center gap-10 py-24 lg:(grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] gap-16)"
	aria-labelledby="home-deploy-title"
	data-home-deploy
>
	<div>
		<p class="eyebrow">Deploy</p>
		<h2 id="home-deploy-title" class="mt-4 mb-0 text-38px leading-[1.05] sm:text-48px">
			Production is one file.
		</h2>
		<p class="mt-4 mb-0 max-w-460px text-16px leading-[1.65] text-ink-soft sm:text-17px">
			<code class="font-mono text-[0.9em] text-ink">ridu build</code> compiles the API, the admin, background
			jobs, and migration checks into a single executable. The image around it needs nothing else.
		</p>

		<div class="mt-8">
			<p class="eyebrow" id="home-deploy-database">Database</p>
			<div
				class="mt-3 inline-flex rounded-5px border border-line bg-surface p-1"
				role="radiogroup"
				aria-labelledby="home-deploy-database"
			>
				{
					databases.map((database, index) => (
						<button
							type="button"
							role="radio"
							aria-checked={index === 0 ? 'true' : 'false'}
							tabindex={index === 0 ? 0 : -1}
							class="h-8 rounded-3px border-0 bg-transparent px-3 text-13px text-ink-soft transition-colors hover:text-ink aria-[checked=true]:(bg-surface-raised text-ink shadow-[inset_0_0_0_1px_var(--colors-line-strong)])"
							data-deploy-database={database.id}
							data-dockerfile={dockerfile(database.env)}
						>
							{database.label}
						</button>
					))
				}
			</div>
		</div>
	</div>

	<figure
		class="dockerfile m-0 min-w-0 overflow-hidden rounded-8px border border-line-strong bg-canvas"
	>
		<header class="flex h-10 items-center justify-between border-b border-line bg-surface px-4">
			<span class="font-mono text-11.5px text-ink-faint">Dockerfile</span>
			<button
				type="button"
				class="inline-flex items-center gap-1.5 border-0 bg-transparent font-mono text-11px text-ink-faint hover:text-ink"
				data-copy-code
				data-code={dockerfile(databases[0].env)}
				aria-label="Copy Dockerfile"
			>
				<svg
					viewBox="0 0 24 24"
					class="size-3.5"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					aria-hidden="true"
				>
					<rect x="8" y="8" width="11" height="11" rx="1"></rect>
					<path d="M16 8V5H5v11h3"></path>
				</svg>
				<span>Copy</span>
			</button>
		</header>
		<ol class="ledger m-0 list-none overflow-x-auto py-4 pl-0 pr-4 sm:pr-5">
			{
				lines.map((line, index) => (
					<li class="row" data-deploy-line={'database' in line ? 'database' : undefined}>
						<span
							aria-hidden="true"
							class="select-none pr-3 text-right font-mono text-11px text-ink-faint/60"
						>
							{index + 1}
						</span>
						<span class="flex min-w-0 items-center gap-3">
							{'database' in line ? (
								<span class="shrink-0 font-mono text-13px">
									{databases.map((database, databaseIndex) => (
										<span data-deploy-variant={database.id} hidden={databaseIndex !== 0}>
											<Code code={database.env} lang="dockerfile" theme={riduCodeTheme} inline />
										</span>
									))}
								</span>
							) : (
								<span class="shrink-0 font-mono text-13px">
									<Code code={line.code} lang="dockerfile" theme={riduCodeTheme} inline />
								</span>
							)}
							<span aria-hidden="true" class="leader hidden min-w-5 flex-1 xl:block" />
						</span>
						<span class="note col-start-2 text-12.5px text-ink-faint xl:(col-start-auto whitespace-nowrap)">
							{'database' in line
								? databases.map((database, databaseIndex) => (
										<span data-deploy-variant={database.id} hidden={databaseIndex !== 0}>
											{database.note}
										</span>
									))
								: line.note}
						</span>
					</li>
				))
			}
		</ol>
	</figure>
</section>

<style>
	.dockerfile :global(.astro-code) {
		padding: 0;
		background: transparent !important;
		white-space: pre;
	}
	/* A dotted leader ties each line to its note, like a table of contents. */
	.leader {
		align-self: center;
		height: 1px;
		background-image: radial-gradient(circle, var(--colors-line-strong) 1px, transparent 1.2px);
		background-size: 6px 2px;
		background-repeat: repeat-x;
		opacity: 0.8;
	}
	/* One grid for every line, so notes share a column and each leader runs
	   from the end of its own code to that column. Notes stack below code
	   until there is room beside it. */
	.ledger {
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr);
	}
	.row {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		align-items: baseline;
		row-gap: 0.25rem;
		padding-block: 0.375rem;
		border-radius: 3px;
		transition: background-color 0.2s ease;
	}
	@media (min-width: 1280px) {
		.ledger {
			grid-template-columns: 2.25rem minmax(0, 1fr) max-content;
			column-gap: 0.75rem;
		}
	}
	.row:hover {
		background: color-mix(in srgb, var(--colors-surface) 70%, transparent);
	}
	.row:hover .leader {
		background-image: radial-gradient(circle, var(--colors-accent) 1px, transparent 1.2px);
	}
	.row:hover .note {
		color: var(--colors-ink);
	}
	/* Switching database briefly marks the one line that changed. */
	[data-deploy-line='database'].changed {
		animation: deploy-changed 1.1s ease;
	}
	[data-deploy-line='database'].changed [data-deploy-variant]:not([hidden]) {
		animation: deploy-swap 0.35s ease;
	}
	@keyframes deploy-changed {
		from {
			background: var(--colors-accent-soft);
		}
	}
	@keyframes deploy-swap {
		from {
			opacity: 0;
			transform: translateY(3px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		[data-deploy-line='database'].changed,
		[data-deploy-line='database'].changed [data-deploy-variant]:not([hidden]) {
			animation: none;
		}
	}
</style>

<script>
	function initializeHomeDeploy() {
		for (const section of document.querySelectorAll<HTMLElement>('[data-home-deploy]')) {
			if (section.dataset.homeDeployReady !== undefined) continue;
			section.dataset.homeDeployReady = '';
			const options = [...section.querySelectorAll<HTMLButtonElement>('[data-deploy-database]')];
			const variants = [...section.querySelectorAll<HTMLElement>('[data-deploy-variant]')];
			const line = section.querySelector<HTMLElement>('[data-deploy-line="database"]');
			const copy = section.querySelector<HTMLButtonElement>('[data-copy-code]');

			const choose = (option: HTMLButtonElement) => {
				for (const candidate of options) {
					const checked = candidate === option;
					candidate.setAttribute('aria-checked', String(checked));
					candidate.tabIndex = checked ? 0 : -1;
				}
				for (const variant of variants) {
					variant.hidden = variant.dataset.deployVariant !== option.dataset.deployDatabase;
				}
				if (copy) copy.dataset.code = option.dataset.dockerfile ?? '';
				if (line) {
					line.classList.remove('changed');
					void line.offsetWidth;
					line.classList.add('changed');
				}
			};

			for (const option of options) {
				option.addEventListener('click', () => choose(option));
				option.addEventListener('keydown', (event) => {
					if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) return;
					event.preventDefault();
					const direction = event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 1;
					const next =
						options[(options.indexOf(option) + direction + options.length) % options.length];
					next.focus();
					choose(next);
				});
			}
		}
	}
	initializeHomeDeploy();
	document.addEventListener('astro:page-load', initializeHomeDeploy);
</script>

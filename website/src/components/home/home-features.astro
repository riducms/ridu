---
import CodeBlock from '@/components/code/code-block.astro';

const access = `Read: func(ridu.AccessContext) (
	ridu.AccessDecision, error,
) {
	return ridu.Where(
		query.Equal("status", "published"),
	), nil
},`;

const hook = `func(ctx ridu.HookContext) error {
	title, _ := ctx.Data["title"].StringValue()
	ctx.Data["title"] = store.String(
		strings.TrimSpace(title),
	)
	return nil
}`;

const computed = `field.Virtual("displayName",
	func(ctx operation.Context) (
		operation.Value[string], error,
	) {
		first, _ := ctx.Root.String("firstName")
		last, _ := ctx.Root.String("lastName")
		name := first + " " + last
		return operation.Present(name), nil
	})`;

const blocks = `field.Blocks("layout",
	field.Block{Slug: "hero", Fields: heroFields},
	field.Block{Slug: "quote", Fields: quoteFields},
	field.Block{Slug: "gallery", Fields: galleryFields},
)`;

// The response for the computed-field card; the computed member is highlighted.
const responseStart = `{
  "firstName": "Ada",
  "lastName": "Lovelace",
`;
const responseComputed = `  "displayName": "Ada Lovelace"`;
const responseEnd = `
}`;

const posts = [
	{ title: 'Hello from Ridu', status: 'Published' },
	{ title: 'Designing with blocks', status: 'Published' },
	{ title: 'Shipping one binary', status: 'Published' }
];
---

<section class="py-24" aria-labelledby="home-features-title">
	<div class="max-w-700px">
		<p class="eyebrow">Behaviour in code</p>
		<h2 id="home-features-title" class="mt-4 mb-0 text-38px leading-[1.05] sm:text-48px">
			Access rules, hooks and computed fields are Go functions
		</h2>
		<p class="mt-4 mb-0 text-16px leading-[1.65] text-ink-soft sm:text-18px">
			They run for every request, whether it comes from the admin, the REST API, the SDK or your own
			Go code. Here are four small examples and what each one does.
		</p>
	</div>

	<div class="mt-12 grid gap-5 lg:grid-cols-2">
		<article class="flex min-w-0 flex-col rounded-8px border border-line bg-surface/60 p-2">
			<header class="px-4 pt-4 pb-3">
				<div class="flex items-baseline justify-between gap-4">
					<h3 class="m-0 font-heading text-22px font-400">Access control</h3>
					<a
						class="shrink-0 text-13px text-ink-faint no-underline transition-colors hover:text-accent"
						href="/docs/access-control/#collection-rules"
						>Docs<span class="sr-only"> for access control</span>
						<span aria-hidden="true" class="ml-1">→</span></a
					>
				</div>
				<p class="mt-1.5 mb-0 text-14px text-ink-soft">
					Signed-out visitors only get published posts. The filter is applied in the database query.
				</p>
			</header>
			<CodeBlock code={access} lang="go" label="Collection.Access" compact />
			<div class="mt-2 rounded-5px bg-canvas/60 px-4 py-4">
				<p class="eyebrow">What a signed-out visitor gets</p>
				<ul class="mt-3 mb-0 grid list-none gap-1.5 p-0">
					{
						posts.map((post) => (
							<li class="flex items-center justify-between rounded-4px bg-surface-raised px-3 py-2 text-13.5px">
								{post.title}
								<span class="rounded-3px bg-green/12 px-1.5 py-0.5 text-11px text-green">
									{post.status}
								</span>
							</li>
						))
					}
				</ul>
				<p class="mt-2.5 mb-0 text-12px text-ink-faint">
					Drafts aren't returned, and they aren't included in the total count.
				</p>
			</div>
		</article>

		<article class="flex min-w-0 flex-col rounded-8px border border-line bg-surface/60 p-2">
			<header class="px-4 pt-4 pb-3">
				<div class="flex items-baseline justify-between gap-4">
					<h3 class="m-0 font-heading text-22px font-400">Lifecycle hooks</h3>
					<a
						class="shrink-0 text-13px text-ink-faint no-underline transition-colors hover:text-accent"
						href="/docs/hooks/collections/#before-change"
						>Docs<span class="sr-only"> for lifecycle hooks</span>
						<span aria-hidden="true" class="ml-1">→</span></a
					>
				</div>
				<p class="mt-1.5 mb-0 text-14px text-ink-soft">
					Trims the title before it's saved, whichever API the save came from.
				</p>
			</header>
			<CodeBlock code={hook} lang="go" label="BeforeChange" compact />
			<div class="mt-2 grid gap-2 rounded-5px bg-canvas/60 px-4 py-4 font-mono text-13px">
				<p class="eyebrow font-sans">Saved title</p>
				<div class="flex flex-wrap items-center gap-3">
					<span class="rounded-4px bg-surface-raised px-3 py-2 text-ink-soft"
						>"<span class="text-accent/70">··</span>Hello, Ridu<span class="text-accent/70"
							>···</span
						>"</span
					>
					<span class="text-accent">→</span>
					<span class="rounded-4px bg-surface-raised px-3 py-2 text-ink">"Hello, Ridu"</span>
				</div>
			</div>
		</article>

		<article class="flex min-w-0 flex-col rounded-8px border border-line bg-surface/60 p-2">
			<header class="px-4 pt-4 pb-3">
				<div class="flex items-baseline justify-between gap-4">
					<h3 class="m-0 font-heading text-22px font-400">Computed fields</h3>
					<a
						class="shrink-0 text-13px text-ink-faint no-underline transition-colors hover:text-accent"
						href="/docs/fields/virtual/#example"
						>Docs<span class="sr-only"> for computed fields</span>
						<span aria-hidden="true" class="ml-1">→</span></a
					>
				</div>
				<p class="mt-1.5 mb-0 text-14px text-ink-soft">
					Add a value to API responses without storing it.
				</p>
			</header>
			<CodeBlock code={computed} lang="go" label="Collection.Fields" compact />
			<div class="mt-2 rounded-5px bg-canvas/60 px-4 py-4 font-mono text-13px leading-[1.7]">
				<p class="eyebrow font-sans">GET /api/people/ada</p>
				<pre
					class="mt-2 mb-0 overflow-x-auto whitespace-pre text-ink-soft">{responseStart}<span class="rounded-2px bg-accent-soft text-accent">{responseComputed}</span>{responseEnd}</pre>
			</div>
		</article>

		<article class="flex min-w-0 flex-col rounded-8px border border-line bg-surface/60 p-2">
			<header class="px-4 pt-4 pb-3">
				<div class="flex items-baseline justify-between gap-4">
					<h3 class="m-0 font-heading text-22px font-400">Typed content blocks</h3>
					<a
						class="shrink-0 text-13px text-ink-faint no-underline transition-colors hover:text-accent"
						href="/docs/fields/blocks/#example"
						>Docs<span class="sr-only"> for typed content blocks</span>
						<span aria-hidden="true" class="ml-1">→</span></a
					>
				</div>
				<p class="mt-1.5 mb-0 text-14px text-ink-soft">
					Define the blocks editors can add to a page, and the fields in each one.
				</p>
			</header>
			<CodeBlock code={blocks} lang="go" label="Collection.Fields" compact />
			<div class="mt-2 rounded-5px bg-canvas/60 px-4 py-4">
				<p class="eyebrow">In the admin</p>
				<div class="mt-3 grid grid-cols-3 gap-2">
					{
						['Hero', 'Quote', 'Gallery'].map((name, index) => (
							<div
								class:list={[
									'rounded-5px border px-3 py-3 text-center text-13px',
									index === 0
										? 'border-accent/60 bg-accent-soft text-ink'
										: 'border-line bg-surface-raised text-ink-soft'
								]}
							>
								<span
									aria-hidden="true"
									class="mx-auto mb-2 block h-8 w-full rounded-3px bg-line-strong/70"
								/>
								{name}
							</div>
						))
					}
				</div>
			</div>
		</article>
	</div>
</section>

---
import CodeBlock from '@/components/code/code-block.astro';
import { resolvedReferenceTypeLinks, type ReferenceSymbol } from '@/reference';
import { splitReferenceType } from '@/reference/signature';
import ReferenceSignature from './reference-signature.astro';
import ReferenceProperties from './reference-properties.astro';
import ReferenceProse from './reference-prose.astro';

interface Props {
	symbol: ReferenceSymbol;
	href: string;
	embedded?: boolean;
}

const { symbol, href, embedded = false } = Astro.props;
const typeLinks = resolvedReferenceTypeLinks(symbol);
const callableType =
	symbol.kind === 'type' &&
	(/\bfunc\s*\(/.test(symbol.signature) || /=\s*\(/.test(symbol.signature));
const callableSymbol = ['function', 'method', 'command'].includes(symbol.kind) || callableType;
const exampleLanguage =
	symbol.language === 'ts' ? 'ts' : symbol.language === 'shell' ? 'bash' : 'go';
const parametersLabel = callableSymbol ? 'Arguments' : symbol.parametersLabel || 'Properties';
const sectionID = (name: string) => (embedded ? `${symbol.slug}-${name}` : name);
const Heading = embedded ? 'h3' : 'h2';
const sections = [
	...(!embedded && symbol.example ? [{ id: 'example', label: 'Example' }] : []),
	...(symbol.parameters.length ? [{ id: 'arguments', label: parametersLabel }] : []),
	...(symbol.options?.length ? [{ id: 'options', label: symbol.optionsLabel || 'Options' }] : []),
	...(symbol.returns ? [{ id: 'returns', label: 'Returns' }] : []),
	...(symbol.details.length ? [{ id: 'behavior', label: 'How it works' }] : []),
	{ id: 'signature', label: 'Full signature' }
];
---

<div class:list={['reference-definition', { 'reference-definition--embedded': embedded }]}>
	<p class="reference-lede"><ReferenceProse text={symbol.summary} /></p>
	{
		!embedded && (
			<nav class="reference-on-page" aria-label="On this API page">
				{sections.map((section) => (
					<a href={`#${section.id}`}>{section.label}</a>
				))}
			</nav>
		)
	}

	{
		!embedded && symbol.example && (
			<section class="reference-api-section reference-example" id="example">
				<Heading>Example</Heading>
				<CodeBlock code={symbol.example} lang={exampleLanguage} label={symbol.language} />
			</section>
		)
	}

	{
		symbol.parameters.length > 0 && (
			<section class="reference-api-section" id={sectionID('arguments')}>
				<Heading>{parametersLabel}</Heading>
				<ReferenceProperties
					parameters={symbol.parameters}
					{typeLinks}
					label={parametersLabel}
					nameLabel={callableSymbol ? 'Argument' : 'Property'}
					showTypes={!symbol.options?.length}
				/>
			</section>
		)
	}

	{
		symbol.options && symbol.options.length > 0 && (
			<section class="reference-api-section" id={sectionID('options')}>
				<Heading>{symbol.optionsLabel || 'Options'}</Heading>
				<ReferenceProperties
					parameters={symbol.options}
					{typeLinks}
					label={symbol.optionsLabel || 'Options'}
				/>
			</section>
		)
	}

	{
		symbol.returns && (
			<section class="reference-api-section" id={sectionID('returns')}>
				<Heading>Returns</Heading>
				<p class="reference-return">
					<ReferenceProse text={symbol.returns.description} />
				</p>
				<code class="reference-return-type">
					{splitReferenceType(symbol.returns.type).map((part) =>
						Object.hasOwn(typeLinks, part) ? <a href={typeLinks[part]}>{part}</a> : part
					)}
				</code>
			</section>
		)
	}

	{
		symbol.details.length > 0 && (
			<section class="reference-api-section reference-detail" id={sectionID('behavior')}>
				<Heading>How it works</Heading>
				{symbol.details.map((paragraph) => (
					<p>
						<ReferenceProse text={paragraph} />
					</p>
				))}
			</section>
		)
	}

	<section class="reference-api-section" id={sectionID('signature')}>
		<Heading>
			Full signature{symbol.overloads.length > 1 ? ` (${symbol.overloads.length} overloads)` : ''}
		</Heading>
		<div class="reference-full-signature">
			<ReferenceSignature
				signature={symbol.signature}
				name={symbol.name}
				parameters={symbol.parameters}
				{typeLinks}
				symbolHref={href}
			/>
			{
				!embedded && symbol.source && (
					<p class="reference-source">
						<a href={symbol.source.url}>
							Source{' '}
							<code>
								{symbol.source.path}:{symbol.source.line}
							</code>
						</a>
					</p>
				)
			}
		</div>
	</section>
</div>

{
	"schemaVersion": 1,
	"records": [
		{
			"module": "cli",
			"id": "cli:ridu#ridu new",
			"name": "ridu new",
			"kind": "command",
			"signature": "ridu new [--template starter|blank] [--database postgres|sqlite|mongodb] [--package-manager npm|bun|pnpm|yarn] [--agent codex|claude|cursor|all|none] [--no-agent] [--module <go-module>] [--scope <npm-scope>] [directory]",
			"members": [],
			"parameters": [
				{
					"name": "--template",
					"type": "starter | blank",
					"description": "Embedded application template; defaults to starter."
				},
				{
					"name": "--database",
					"type": "postgres | sqlite | mongodb",
					"description": "Official database adapter; defaults to postgres."
				},
				{
					"name": "--package-manager",
					"type": "npm | bun | pnpm | yarn",
					"description": "Frontend package manager; defaults to npm outside the interactive wizard."
				},
				{
					"name": "--agent",
					"type": "codex | claude | cursor | all | none",
					"description": "Release-matched local coding-agent layout; defaults to codex outside a terminal."
				},
				{
					"name": "--no-agent",
					"type": "boolean",
					"description": "Do not install coding-agent entrypoints, skills, or ownership manifest."
				},
				{
					"name": "--module",
					"type": "string",
					"description": "Go module path; defaults to example.com/<project>."
				},
				{
					"name": "--scope",
					"type": "string",
					"description": "npm scope for the generated admin workspace; defaults to @<project>."
				},
				{
					"name": "directory",
					"type": "string",
					"description": "New project directory, or . for the current directory. In-place creation warns and rejects conflicting project paths before adding files."
				}
			],
			"aliases": ["ridu new"],
			"overloads": []
		},

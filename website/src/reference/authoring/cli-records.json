		{
			"module": "cli",
			"id": "cli:ridu#ridu dev",
			"name": "ridu dev",
			"kind": "command",
			"signature": "ridu dev [--database-url <url> | --database-path <path>] [--address <host:port>] [--admin-port <port>] [--no-docker] [--no-install] [--no-sync]",
			"members": [],
			"parameters": [
				{
					"name": "--database-url",
					"type": "string",
					"description": "PostgreSQL or MongoDB development URL; defaults to DATABASE_URL, then the selected scaffold Compose service."
				},
				{
					"name": "--database-path",
					"type": "string",
					"description": "SQLite-only development path; defaults to RIDU_SQLITE_PATH, then .ridu/development.sqlite."
				},
				{
					"name": "--address",
					"type": "string",
					"description": "Go API listen address; defaults to 127.0.0.1:8080."
				},
				{
					"name": "--admin-port",
					"type": "number",
					"description": "Vite admin port; defaults to 5173."
				},
				{
					"name": "--no-docker",
					"type": "boolean",
					"description": "Do not start the scaffolded PostgreSQL or MongoDB Compose service."
				},
				{
					"name": "--no-install",
					"type": "boolean",
					"description": "Do not install missing frontend dependencies with the configured package manager."
				},
				{
					"name": "--no-sync",
					"type": "boolean",
					"description": "Do not apply a safe non-destructive development schema plan."
				}
			],
			"aliases": ["ridu dev"],
			"overloads": []

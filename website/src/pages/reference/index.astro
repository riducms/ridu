---
import ReferenceShell from '@/components/reference/reference-shell.astro';
import { groupReferenceModules, referenceModules } from '@/reference';

const groups = groupReferenceModules(referenceModules);
const symbolCount = referenceModules.reduce((total, module) => total + module.symbols.length, 0);
---

<ReferenceShell
	title="API reference"
	description="Public Go, TypeScript, CLI, and plugin APIs for Ridu."
>
	<article class="reference-page reference-page--landing">
		<header class="reference-header reference-header--landing mb-11.5">
			<p class="eyebrow">API reference</p>
			<h1 class="mt-2.5 mb-3 text-39px leading-[1.02] sm:text-48px">
				Ridu APIs, package by package.
			</h1>
			<p class="m-0 text-16px leading-[1.55] text-ink-soft">
				Browse application authoring, runtime, Fetch SDK, protocol, admin extension, migration,
				storage, plugin, and CLI APIs across {referenceModules.length} modules and{' '}
				{symbolCount.toLocaleString('en-GB')} searchable symbols. Press{' '}
				<kbd class="border border-line-strong px-1.25 py-px font-mono text-11px">/</kbd> to search.
			</p>
			<p class="mt-3 mb-0 text-13.5px leading-[1.55] text-ink-faint">
				New to Ridu? Start with the <a href="/docs/getting-started/">task-oriented guides</a>, then
				use this catalog for signatures, defaults, errors, and focused examples.
			</p>
		</header>

		{
			[...groups].map(([group, modules]) => (
				<section class="mt-11 first:mt-0">
					<h2 class="mt-0 mb-3.5 text-23px">{group}</h2>
					<div class="reference-module-grid">
						{modules.map((module) => (
							<a class="reference-module-card" href={`/reference/${module.slug}/`}>
								<code class="reference-module-name">{module.name}</code>
								<p>{module.summary}</p>
							</a>
						))}
					</div>
				</section>
			))
		}
	</article>
</ReferenceShell>

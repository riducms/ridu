---
import '@fontsource/questrial/400.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/martian-mono';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import riduArchLogo from '@/assets/ridu-logo-arch.svg';
import CodeCopyScript from '@/components/code/code-copy-script.astro';
import SiteFooter from '@/components/chrome/site-footer.astro';
import SiteHeader from '@/components/chrome/site-header.astro';
import type { DocumentationLayout } from '@/config/documentation';
import { site, type ProductKey } from '@/config/site';

interface Props {
	title?: string;
	description?: string;
	active?: 'docs' | 'guides' | 'reference';
	product?: ProductKey;
	wide?: boolean;
	docsLayout?: DocumentationLayout;
	footer?: boolean;
	noindex?: boolean;
}

const {
	title,
	description = site.description,
	active,
	wide = false,
	docsLayout,
	footer = true,
	noindex = false
} = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const siteURL = new URL('/', Astro.site ?? site.url);
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': new URL('#website', siteURL).href,
			url: siteURL.href,
			name: site.name,
			description: site.description,
			about: { '@id': new URL('#software', siteURL).href }
		},
		{
			'@type': 'SoftwareSourceCode',
			'@id': new URL('#software', siteURL).href,
			name: site.name,
			url: siteURL.href,
			description: site.description,
			codeRepository: site.github,
			license: site.license,
			programmingLanguage: site.programmingLanguage
		}
	]
};
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href={new URL('/sitemap-index.xml', siteURL)} />
		<link rel="icon" type="image/svg+xml" href={riduArchLogo.src} />
		<meta name="theme-color" content="#0d0a0c" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		{
			Astro.url.pathname === '/' && (
				<script
					is:inline
					type="application/ld+json"
					set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
				/>
			)
		}
		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader active={active} {wide} {docsLayout} />
		<main id="main" class:list={{ 'mx-auto w-site': !wide }}>
			<slot />
		</main>
		{footer && <SiteFooter />}
		<CodeCopyScript />
	</body>
</html>

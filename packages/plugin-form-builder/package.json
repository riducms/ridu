{
	"name": "@riducms/plugin-form-builder",
	"description": "Dynamic form contracts and admin pairing for Ridu's official Form Builder plugin.",
	"version": "0.19.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riducms/ridu.git",
		"directory": "packages/plugin-form-builder"
	},
	"homepage": "https://riducms.com",
	"bugs": {
		"url": "https://github.com/riducms/ridu/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./admin": {
			"types": "./dist/admin.d.ts",
			"svelte": "./dist/admin.js",
			"default": "./dist/admin.js"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "bun run package",
		"package": "svelte-kit sync && svelte-package && publint",
		"dev": "svelte-kit sync && bun run --parallel dev:package",
		"dev:package": "svelte-package --watch",
		"check": "svelte-kit sync && tsc -p tsconfig.json",
		"test": "svelte-kit sync && bun test"
	},
	"peerDependencies": {
		"@riducms/plugin": "workspace:*"
	},
	"devDependencies": {
		"@riducms/plugin": "workspace:*",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"publint": "^0.3.25",
		"typescript": "~6.0.2"
	},
	"peerDependenciesMeta": {
		"@riducms/plugin": {
			"optional": true
		}
	}
}

{
	"name": "@riducms/ui",
	"description": "Framework-owned Svelte UI primitives shared by Ridu admin surfaces.",
	"version": "0.20.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riducms/ridu.git",
		"directory": "packages/ui"
	},
	"homepage": "https://riducms.com",
	"bugs": {
		"url": "https://github.com/riducms/ridu/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css",
		"./layers.css": "./dist/layers.css",
		"./styles.scss": "./dist/styles/_index.scss",
		"./code-theme": {
			"types": "./dist/code-theme.d.ts",
			"svelte": "./dist/code-theme.js",
			"default": "./dist/code-theme.js"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css",
		"**/*.scss"
	],
	"scripts": {
		"build": "bun run package",
		"package": "svelte-kit sync && svelte-package && bun ../../scripts/finish-svelte-package.ts && publint",
		"dev": "svelte-kit sync && bun run --parallel dev:package dev:finish",
		"dev:package": "svelte-package --watch",
		"dev:finish": "bun ../../scripts/finish-svelte-package.ts --watch",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"bits-ui": "^2.19.5"
	},
	"peerDependencies": {
		"svelte": "^5.56.8"
	},
	"devDependencies": {
		"@iconify/json": "^2.2.509",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"publint": "^0.3.25"
	}
}

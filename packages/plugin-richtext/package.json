{
	"name": "@riducms/plugin-richtext",
	"description": "Svelte and Lexical admin integration for Ridu's official rich-text plugin.",
	"version": "0.19.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riducms/ridu.git",
		"directory": "packages/plugin-richtext"
	},
	"homepage": "https://riducms.com",
	"bugs": {
		"url": "https://github.com/riducms/ridu/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./editor": {
			"types": "./dist/editor/index.d.ts",
			"svelte": "./dist/editor/index.js",
			"default": "./dist/editor/index.js"
		},
		"./editor.scss": "./dist/styles/editor.scss",
		"./markdown": {
			"types": "./dist/markdown/index.d.ts",
			"svelte": "./dist/markdown/index.js",
			"default": "./dist/markdown/index.js"
		},
		"./svelte": {
			"types": "./dist/render/index.d.ts",
			"svelte": "./dist/render/index.js",
			"default": "./dist/render/index.js"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css",
		"**/*.scss"
	],
	"scripts": {
		"build": "bun run package",
		"package": "svelte-kit sync && svelte-package && bun ../../scripts/finish-svelte-package.ts --lexical && publint",
		"dev": "svelte-kit sync && bun run --parallel dev:package dev:finish",
		"dev:package": "svelte-package --watch",
		"dev:finish": "bun ../../scripts/finish-svelte-package.ts --watch --lexical",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "svelte-kit sync && bun test"
	},
	"dependencies": {
		"@hvniel/lexical-svelte": "^0.1.1",
		"@lexical/clipboard": "0.49.0",
		"@lexical/code": "0.49.0",
		"@lexical/code-core": "0.49.0",
		"@lexical/extension": "0.49.0",
		"@lexical/history": "0.49.0",
		"@lexical/link": "0.49.0",
		"@lexical/list": "0.49.0",
		"@lexical/markdown": "0.49.0",
		"@lexical/rich-text": "0.49.0",
		"@lexical/selection": "0.49.0",
		"@lexical/utils": "0.49.0",
		"@riducms/plugin": "workspace:*",
		"@riducms/protocol": "workspace:*",
		"@riducms/sdk": "workspace:*",
		"@riducms/ui": "workspace:*",
		"@types/prismjs": "^1.26.5",
		"esm-env": "^1.2.2",
		"lexical": "0.49.0",
		"prismjs": "^1.30.0"
	},
	"peerDependencies": {
		"svelte": "^5.56.8"
	},
	"devDependencies": {
		"@iconify/json": "^2.2.509",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"publint": "^0.3.25"
	}
}

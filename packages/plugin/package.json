{
	"name": "@riducms/plugin",
	"description": "Public TypeScript contracts for statically registered Ridu admin plugins.",
	"version": "0.21.1",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riducms/ridu.git",
		"directory": "packages/plugin"
	},
	"homepage": "https://riducms.com",
	"bugs": {
		"url": "https://github.com/riducms/ridu/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./authoring/v1": {
			"types": "./dist/authoring/v1.d.ts",
			"svelte": "./dist/authoring/v1.js",
			"default": "./dist/authoring/v1.js"
		},
		"./admin": {
			"types": "./dist/admin.d.ts",
			"svelte": "./dist/admin.js",
			"default": "./dist/admin.js"
		},
		"./editor": {
			"types": "./dist/editor/index.d.ts",
			"svelte": "./dist/editor/index.js",
			"default": "./dist/editor/index.js"
		},
		"./editor/field": {
			"types": "./dist/editor/field.d.ts",
			"svelte": "./dist/editor/field.js",
			"default": "./dist/editor/field.js"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "bun run package",
		"package": "svelte-kit sync && svelte-package && publint",
		"dev": "svelte-kit sync && bun run --parallel dev:package",
		"dev:package": "svelte-package --watch",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "svelte-kit sync && bun test"
	},
	"dependencies": {
		"@riducms/protocol": "workspace:*",
		"@riducms/sdk": "workspace:*",
		"@riducms/translations": "workspace:*",
		"@riducms/ui": "workspace:*"
	},
	"peerDependencies": {
		"svelte": "^5.56.8"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"publint": "^0.3.25"
	}
}

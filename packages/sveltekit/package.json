{
	"name": "@riducms/sveltekit",
	"description": "SvelteKit integration for Ridu: direct browser requests, server rendering, and one session owner.",
	"version": "0.20.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riducms/ridu.git",
		"directory": "packages/sveltekit"
	},
	"homepage": "https://riducms.com",
	"bugs": {
		"url": "https://github.com/riducms/ridu/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"svelte": "./dist/server.js",
			"default": "./dist/server.js"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "bun run package",
		"package": "svelte-kit sync && svelte-package && publint",
		"dev": "svelte-kit sync && bun run --parallel dev:package",
		"dev:package": "svelte-package --watch",
		"check": "svelte-kit sync && tsc -p tsconfig.json",
		"test": "svelte-kit sync && bun test"
	},
	"dependencies": {
		"esm-env": "^1.2.2"
	},
	"peerDependencies": {
		"@riducms/sdk": "workspace:*",
		"@sveltejs/kit": "^2.20.0 || ^3.0.0",
		"svelte": "^5.29.0"
	},
	"devDependencies": {
		"@riducms/sdk": "workspace:*",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"publint": "^0.3.25"
	}
}

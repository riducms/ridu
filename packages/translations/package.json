{
	"name": "@riducms/translations",
	"description": "Typed admin translations, language negotiation, plurals, and Intl formatting for Ridu.",
	"version": "0.19.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riducms/ridu.git",
		"directory": "packages/translations"
	},
	"homepage": "https://riducms.com",
	"bugs": {
		"url": "https://github.com/riducms/ridu/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./languages/en": {
			"types": "./dist/languages/en.d.ts",
			"import": "./dist/languages/en.js",
			"default": "./dist/languages/en.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc -p tsconfig.json",
		"test": "bun test"
	}
}

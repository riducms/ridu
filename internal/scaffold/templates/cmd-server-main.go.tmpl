package main

import (
	"context"
{{if .MongoDB}}	"fmt"
{{end}}	"log"
	"os"
{{if not .MongoDB}}	"strconv"
{{end}}
	"{{.ModulePath}}/content"
	"{{.ModulePath}}/internal/adminassets"
	"github.com/riducms/ridu"
{{if .Postgres}}	"github.com/riducms/ridu/adapters/postgres"
{{else if .MongoDB}}	"github.com/riducms/ridu/adapters/mongodb"
{{else if .SQLite}}	"github.com/riducms/ridu/adapters/sqlite"
{{end}}	"github.com/riducms/ridu/store"
)

{{if .MongoDB}}const internalDevelopmentServerArgument = "--ridu-internal-development-server"

{{end}}func main() {
	applicationConfig := content.Config()
{{if .MongoDB}}	internalDevelopmentServer := len(os.Args) == 2 && os.Args[1] == internalDevelopmentServerArgument
	if internalDevelopmentServer {
		os.Args = os.Args[:1]
	}
{{end}}	// The migration driver lets the built binary apply its own migrations with
	// `migrate up`, so production needs no Ridu CLI. Register data transforms here.
	options := []ridu.ExecuteOption{
		ridu.WithProjectMigrations({{if .Postgres}}postgres{{else if .MongoDB}}mongodb{{else if .SQLite}}sqlite{{end}}.ProjectMigrations()),
	}
	if len(os.Args) == 1 {
		options = append(options, runtimeOptions({{if .MongoDB}}applicationConfig, internalDevelopmentServer{{end}})...)
	}
	if err := ridu.Execute(applicationConfig, options...); err != nil {
		log.Fatal(err)
	}
}

// runtimeOptions holds what this application chooses for its server. Ridu
// reads its standard variables itself, such as RIDU_ADDRESS, the allowed
// hosts and the database connection, for every option left unset here; an
// option set here wins over its variable. The readiness overrides are the
// exception: each turns off a production check, so only this code sets them.
func runtimeOptions({{if .MongoDB}}applicationConfig ridu.Config, internalDevelopmentServer bool{{end}}) []ridu.ExecuteOption {
	return []ridu.ExecuteOption{
		ridu.WithStore(func(ctx context.Context) (store.Store, error) {
{{if .Postgres}}			config, err := postgres.ConfigFromEnvironment()
			if err != nil {
				return nil, err
			}
			return postgres.OpenWithConfig(ctx, config)
{{else if .MongoDB}}			config, err := mongodb.ConfigFromEnvironment()
			if err != nil {
				return nil, err
			}
			config.ApplicationName = "ridu-server"
			backend, err := mongodb.OpenWithConfig(ctx, config)
			if err != nil {
				return nil, err
			}
			if internalDevelopmentServer {
				manifest, err := ridu.Resolve(applicationConfig)
				if err != nil {
					_ = backend.Close()
					return nil, fmt.Errorf("resolve MongoDB development manifest: %w", err)
				}
				if err := backend.VerifyIndexes(ctx, manifest); err != nil {
					_ = backend.Close()
					return nil, fmt.Errorf("verify MongoDB development indexes: %w", err)
				}
			}
			return backend, nil
{{else if .SQLite}}			config, err := sqlite.ConfigFromEnvironment()
			if err != nil {
				return nil, err
			}
			return sqlite.OpenWithConfig(ctx, config)
{{end}}		}),
		ridu.WithHandlerOptions(ridu.HandlerOptions{AdminAssets: adminassets.FS()}),
		ridu.WithServerOptions(ridu.ServerOptions{
{{if .MongoDB}}			AllowUnverifiableReadiness: internalDevelopmentServer,
			SkipReadinessPreflight:     internalDevelopmentServer,
{{else}}			AllowUnverifiableReadiness: readinessOverride("RIDU_ALLOW_UNVERIFIABLE_READINESS"),
			SkipReadinessPreflight:     readinessOverride("RIDU_SKIP_READINESS_PREFLIGHT"),
{{end}}		}),
	}
}
{{if not .MongoDB}}
// readinessOverride reads a readiness override that ridu dev sets for its
// development server. Never set one for a production server.
func readinessOverride(name string) bool {
	raw := os.Getenv(name)
	if raw == "" {
		return false
	}
	enabled, err := strconv.ParseBool(raw)
	if err != nil {
		log.Fatalf("%s must be true or false: %v", name, err)
	}
	return enabled
}
{{end}}
{
  "$id": "https://riducms.com/schemas/richtext/document/1",
  "type": "object",
  "required": [
    "version",
    "root"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "allOf": [
        {
          "$ref": "#/$defs/node"
        },
        {
          "properties": {
            "type": {
              "const": "root"
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "root",
            "paragraph",
            "heading",
            "quote",
            "text",
            "linebreak",
            "link",
            "list",
            "listitem",
            "code",
            "horizontalrule",
            "upload",
            "relationship",
            "block"
          ]
        },
        "version": {
          "const": 1
        },
        "children": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/node"
              },
              {
                "properties": {
                  "type": {
                    "not": {
                      "const": "root"
                    }
                  }
                }
              }
            ]
          }
        },
        "fields": {
          "type": "object"
        },
        "text": {
          "type": "string"
        },
        "format": {
          "type": [
            "integer",
            "string"
          ]
        },
        "detail": {
          "type": "integer"
        },
        "mode": {
          "enum": [
            "normal",
            "token",
            "segmented"
          ]
        },
        "style": {
          "type": "string"
        },
        "textFormat": {
          "type": "integer"
        },
        "textStyle": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            null
          ]
        },
        "indent": {
          "type": "integer"
        },
        "tag": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "rel": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "listType": {
          "type": "string"
        },
        "start": {
          "type": "integer"
        },
        "value": {
          "type": "integer"
        },
        "checked": {
          "type": "boolean"
        },
        "language": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "relationTo": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "block"
              }
            }
          },
          "then": {
            "required": [
              "type",
              "version",
              "fields"
            ],
            "properties": {
              "type": {
                "const": "block"
              },
              "version": {
                "const": 1
              },
              "fields": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "else": {
            "not": {
              "required": [
                "fields"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "root",
                  "paragraph",
                  "heading",
                  "quote",
                  "link",
                  "list",
                  "listitem",
                  "code"
                ]
              }
            }
          },
          "then": {
            "required": [
              "children"
            ]
          },
          "else": {
            "not": {
              "required": [
                "children"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "format": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "format": {
                "enum": [
                  "",
                  "left",
                  "center",
                  "right",
                  "justify",
                  "start",
                  "end"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "root"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version",
                "children",
                "direction",
                "format",
                "indent"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "paragraph"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version",
                "children",
                "direction",
                "format",
                "indent",
                "textFormat",
                "textStyle"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "quote"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version",
                "children",
                "direction",
                "format",
                "indent",
                "textFormat",
                "textStyle"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version",
                "children",
                "direction",
                "format",
                "indent",
                "textFormat",
                "textStyle",
                "tag"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version",
                "children",
                "direction",
                "format",
                "indent",
                "textFormat",
                "textStyle",
                "url",
                "target",
                "rel",
                "title"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version",
                "children",
                "direction",
                "format",
                "indent",
                "textFormat",
                "textStyle",
                "listType",
                "start",
                "tag"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "listitem"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version",
                "children",
                "direction",
                "format",
                "indent",
                "textFormat",
                "textStyle",
                "value",
                "checked"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version",
                "children",
                "direction",
                "format",
                "indent",
                "textFormat",
                "textStyle",
                "language",
                "theme"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version",
                "text",
                "detail",
                "format",
                "mode",
                "style"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "linebreak"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "horizontalrule"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "upload"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version",
                "relationTo",
                "id",
                "format",
                "caption"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "relationship"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "version",
                "relationTo",
                "id",
                "format"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              }
            }
          },
          "then": {
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "enum": [
                  "h1",
                  "h2",
                  "h3",
                  "h4",
                  "h5",
                  "h6"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "required": [
              "listType"
            ],
            "properties": {
              "listType": {
                "enum": [
                  "bullet",
                  "number",
                  "check"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
